# Variables de entorno de SIGEBO
# Copiar este archivo a .env y rellenar con los valores reales.
# .env NO se versiona (esta en .gitignore).

# -------- Base de datos --------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=prueba
DB_USER=change-me
DB_PASS=change-me

# -------- SMTP (PHPMailer) --------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your@example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=ssl
MAIL_FROM_EMAIL=your@example.com
MAIL_FROM_NAME=SIGEBO
